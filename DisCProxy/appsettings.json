{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaseUri": "https://localhost:5001",
  "DisCProxy": {
    "Swagger": true,
    "SwaggerEndpoint": "/swagger/v1/swagger.json"
  },

  "jwtTokenConfig": {

    "integratedUserService": true,
    "secret": "CHANGE_ME_replace_with_a_long_random_secret_min_32_chars",
    "issuer": "https://your-domain.example",
    "audience": "https://your-domain.example",
    "accessTokenExpiration": 2000,
    "refreshTokenExpiration": 6000,
    "User": {
      "demoUser": "CHANGE_ME",
      "admin": "CHANGE_ME"
    }
  }
}