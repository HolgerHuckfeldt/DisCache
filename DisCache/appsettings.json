{
  "DisC": {
    "Name": "DisC",
    "DbPath": "./data/disc.db",
    "Events":  true,
    "Swagger": true,
    "SwaggerEndpoint": "/swagger/v1/swagger.json",
    "UseAuthorisation": false,
    "UseRest": true,
    "UsegRpc": true,
    "UseSignalR": true,
    "UseJwt": false
  },
  "CacheBackend": {
    "UseSqlite": true,
    "UseInMemory": false,
    "UseInMemoryAccelerator": true,
    "UseInMemoryAcceleratorTime": 14400,
    "UseRedis": false
  },
  "CacheBackend.UseSqlite": {
    "Path": "./data/data.db"
  },
  "Redis": {
    "UseRedis": false,
    "Server": "127.0.0.1",
    "Port": 6379
  },
  "Monitor": {
    "EF": "./data/stats.db",
    "Name": "Default",
    "Provider": [
      {
        "Type": "Memory",
        "Name": "Sekunden",
        "Default": true,
        "Scale": {
          "Duration": 120,
          "Scale": "Second"
        }
      },
      {
        "Type": "EF",
        "Name": "Minuten",
        "Default": false,
        "Scale": {
          "Duration": 15,
          "Scale": "Minute"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "jwtTokenConfig": {

    "integratedUserService": true,
    "secret": "CHANGE_ME_replace_with_a_long_random_secret_min_32_chars",
    "issuer": "https://your-domain.example",
    "audience": "https://your-domain.example",
    "accessTokenExpiration": 2000,
    "refreshTokenExpiration": 6000,
    "User": {
      "demoUser": "CHANGE_ME",
      "admin": "CHANGE_ME"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/disc.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit ": 3,
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 1000000
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Destructure": [
    ],
    "Properties": {
    }
  }
}